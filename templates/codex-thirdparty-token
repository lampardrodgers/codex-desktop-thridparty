#!/bin/sh
set -eu

env_file="${CODEX_THIRDPARTY_ENV_FILE:-${CODEX_HOME:-$HOME/.codex}/thirdparty.env}"

if [ -n "${CODEX_THIRDPARTY_API_KEY:-}" ]; then
  printf '%s\n' "$CODEX_THIRDPARTY_API_KEY"
  exit 0
fi

if [ ! -r "$env_file" ]; then
  printf 'missing readable third-party env file: %s\n' "$env_file" >&2
  exit 1
fi

value="$(
  awk -F= '
    /^[[:space:]]*(#|$)/ { next }
    {
      key = $1
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
      if (key == "CODEX_THIRDPARTY_API_KEY") {
        sub(/^[^=]*=/, "", $0)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", $0)
        if ($0 ~ /^".*"$/ || $0 ~ /^'\''.*'\''$/) {
          $0 = substr($0, 2, length($0) - 2)
        }
        print $0
        exit
      }
    }
  ' "$env_file"
)"

if [ -z "$value" ]; then
  printf 'CODEX_THIRDPARTY_API_KEY not found in %s\n' "$env_file" >&2
  exit 1
fi

printf '%s\n' "$value"
