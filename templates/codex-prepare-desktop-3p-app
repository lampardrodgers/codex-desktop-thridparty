def patch_index_bundle(index_path: Path) -> None:
    text = index_path.read_text(encoding="utf-8")
    replacements = [
        (
            "let E=o&&d&&l!==`error`&&p.length>0,D;",
            "let E=d&&l!==`error`&&p.length>0,D;",
        ),
        (
            "let w=s&&f&&!p,T;",
            "let w=f&&!p,T;",
        ),
    ]

    for old, new in replacements:
        if new in text:
            continue
        if old not in text:
            raise RuntimeError(f"missing patch anchor in {index_path.name}: {old[:48]}...")
        text = text.replace(old, new, 1)

    index_path.write_text(text, encoding="utf-8")


def prepare_clone(source_app: Path, target_app: Path) -> Path:
    source_app = source_app.expanduser().resolve()
    target_app = target_app.expanduser().resolve()

    if source_app == target_app:
        raise RuntimeError(
            f"refusing to patch app in place: source_app and target_app are both {source_app}"
        )

    target_app.parent.mkdir(parents=True, exist_ok=True)

    source_version = read_version(source_app)
    marker_path = target_app / "Contents" / "Resources" / ".codex-3p-source-version"
    patch_marker_path = target_app / "Contents" / "Resources" / ".codex-3p-patch-revision"
    target_version = marker_path.read_text(encoding="utf-8").strip() if marker_path.exists() else None
    target_patch_revision = (
        patch_marker_path.read_text(encoding="utf-8").strip()
        if patch_marker_path.exists()
        else None
    )

    if (
        target_app.exists()
        and target_version == source_version
        and target_patch_revision == PATCH_REVISION
        and has_expected_identity(target_app)
        and has_valid_signature(target_app)
    ):
        return target_app

    if target_app.exists():
        shutil.rmtree(target_app)

    subprocess.run(["ditto", str(source_app), str(target_app)], check=True)

    target_asar = target_app / "Contents" / "Resources" / "app.asar"
    with tempfile.TemporaryDirectory(prefix="codex-3p-app-") as temp_dir:
        temp_root = Path(temp_dir)
        extracted = temp_root / "extracted"
        patched_asar = temp_root / "app.asar"
        subprocess.run(["npx", "--yes", "asar", "extract", str(target_asar), str(extracted)], check=True)
        font_path = next((extracted / "webview" / "assets").glob("font-settings-*.js"))
        patch_font_settings(font_path)
        patch_index_bundle(next((extracted / "webview" / "assets").glob("index-*.js")))
        patch_bootstrap(extracted / ".vite" / "build" / "bootstrap.js")
        subprocess.run(["npx", "--yes", "asar", "pack", str(extracted), str(patched_asar)], check=True)
        shutil.copy2(patched_asar, target_asar)

    customize_info_plist(target_app, get_asar_header_hash(target_asar))
    marker_path.write_text(source_version + "\n", encoding="utf-8")
    patch_marker_path.write_text(PATCH_REVISION + "\n", encoding="utf-8")
    sign_app(target_app)
    return target_app


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: codex-prepare-desktop-3p-app <source_app> <target_app>", file=sys.stderr)
        return 2

    target_app = prepare_clone(Path(sys.argv[1]), Path(sys.argv[2]))
    print(target_app)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
