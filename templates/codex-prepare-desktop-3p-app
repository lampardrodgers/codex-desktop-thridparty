def read_version(app_path: Path) -> str:
    info_plist = app_path / "Contents" / "Info.plist"
    with info_plist.open("rb") as handle:
        info = plistlib.load(handle)
    return str(
        info.get("CFBundleVersion")
        or info.get("CFBundleShortVersionString")
        or "unknown"
    )


def customize_info_plist(app_path: Path, asar_hash: str | None = None) -> None:
    info_plist = app_path / "Contents" / "Info.plist"
    with info_plist.open("rb") as handle:
        info = plistlib.load(handle)

    info["CFBundleIdentifier"] = "com.openai.codex.thirdparty"
    info["CFBundleName"] = "Codex"
    info["CFBundleDisplayName"] = "Codex 3P"
    if asar_hash is not None:
        integrity = dict(info.get("ElectronAsarIntegrity") or {})
        entry = dict(integrity.get("Resources/app.asar") or {})
        entry["algorithm"] = "SHA256"
        entry["hash"] = asar_hash
        integrity["Resources/app.asar"] = entry
        info["ElectronAsarIntegrity"] = integrity
    ls_environment = dict(info.get("LSEnvironment") or {})
    ls_environment.update(THIRDPARTY_ENVIRONMENT)
    info["LSEnvironment"] = ls_environment

    with info_plist.open("wb") as handle:
        plistlib.dump(info, handle)


def has_expected_identity(app_path: Path) -> bool:
    info_plist = app_path / "Contents" / "Info.plist"
    if not info_plist.exists():
        return False

    with info_plist.open("rb") as handle:
        info = plistlib.load(handle)

    return (
        info.get("CFBundleIdentifier") == "com.openai.codex.thirdparty"
        and info.get("CFBundleName") == "Codex"
        and info.get("CFBundleDisplayName") == "Codex 3P"
    )


def has_valid_signature(app_path: Path) -> bool:
    result = subprocess.run(
        ["codesign", "--verify", "--deep", "--strict", str(app_path)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    return result.returncode == 0


def sign_app(app_path: Path) -> None:
    subprocess.run(
        ["codesign", "--force", "--deep", "--sign", "-", str(app_path)],
        check=True,
    )


def get_asar_header_hash(path: Path) -> str:
    blob = path.read_bytes()
    json_len = struct.unpack_from("<I", blob, 12)[0]
    header_json = blob[16 : 16 + json_len]
    return hashlib.sha256(header_json).hexdigest()


def replace_literal_once(text: str, old: str, new: str, path: Path) -> str:
    if new in text:
        return text
    if old not in text:
        raise RuntimeError(f"missing patch anchor in {path.name}: {old[:48]}...")
    return text.replace(old, new, 1)


def replace_pattern_once(
    text: str,
    pattern: str,
    replacement,
    path: Path,
    *,
    description: str,
    marker: str | None = None,
) -> str:
    if marker is not None and marker in text:
        return text

    updated, count = re.subn(pattern, replacement, text, count=1)
    if count != 1:
        raise RuntimeError(f"missing patch anchor in {path.name}: {description}")
    return updated


def find_asset_by_markers(
    assets_dir: Path,
    preferred_globs: list[str],
    markers: list[str],
    description: str,
) -> Path:
    candidates: list[Path] = []
    seen: set[Path] = set()
    for pattern in preferred_globs:
        for path in sorted(assets_dir.glob(pattern)):
            if path not in seen:
                candidates.append(path)
                seen.add(path)

    for path in sorted(assets_dir.glob("*.js")):
        if path not in seen:
            candidates.append(path)
            seen.add(path)

    for path in candidates:
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
        if all(marker in text for marker in markers):
            return path

    raise RuntimeError(
        f"could not find {description} bundle in {assets_dir}; "
        f"searched {', '.join(preferred_globs)} and *.js"
    )


