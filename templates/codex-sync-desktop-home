    catalog_path = target_home / "model-catalogs" / "thirdparty.json"
    catalog_path.write_text(
        json.dumps(catalog, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def write_openai_catalog(target_home: Path) -> None:
    catalog = build_openai_catalog(target_home)
    catalog_path = target_home / "model-catalogs" / "openai.json"
    catalog_path.write_text(
        json.dumps(catalog, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def build_config(
    profile: str,
    target_home: Path,
    local_marketplaces: dict[str, Path] | None = None,
) -> str:
    if not SOURCE_CONFIG_PATH.exists():
        raise RuntimeError(f"missing source config: {SOURCE_CONFIG_PATH}")

    text = SOURCE_CONFIG_PATH.read_text(encoding="utf-8")
    text = prune_missing_projects(text)

    if profile == "thirdparty":
        catalog_path = str(target_home / "model-catalogs" / "thirdparty.json")
        text = upsert_top_level_value(text, "model_provider", "thirdparty")
        text = upsert_top_level_value(text, "model", "gpt-5.4")
        text = upsert_top_level_value(text, "model_catalog_json", catalog_path)
        text = upsert_top_level_value(text, "service_tier", None)
        text = upsert_profile_catalog(text, catalog_path)
        text = upsert_local_marketplace_sections(text, local_marketplaces or {})
    elif profile == "openai":
        text = upsert_top_level_value(text, "model_provider", "openai")
        text = upsert_top_level_value(text, "model", "gpt-5.4")
        text = remove_named_section(text, "model_providers.thirdparty")
        text = remove_named_section(text, "model_providers.thirdparty.auth")
        text = remove_named_section(text, "profiles.thirdparty")
        text = upsert_top_level_value(text, "model_catalog_json", None)
    else:
        raise RuntimeError(f"unsupported profile: {profile}")

    text = re.sub(r"\n{3,}", "\n\n", text).strip() + "\n"
    return text


def main() -> int:
    if len(sys.argv) != 3:
        print("usage: codex-sync-desktop-home <openai|thirdparty> <target_home>", file=sys.stderr)
        return 2

    profile = sys.argv[1].strip()
    target_home = Path(sys.argv[2]).expanduser().resolve()
    target_home.mkdir(parents=True, exist_ok=True)
    (target_home / "model-catalogs").mkdir(parents=True, exist_ok=True)

    for entry in SHARED_ENTRIES:
        ensure_shared_entry(target_home, entry)

    ensure_private_entry(target_home, "models_cache.json")
    local_marketplaces = (
        write_local_plugin_marketplaces(target_home) if profile == "thirdparty" else {}
    )

    config_text = build_config(profile, target_home, local_marketplaces)
    (target_home / "config.toml").write_text(config_text, encoding="utf-8")
    if profile == "thirdparty":
        ensure_shared_entry(target_home, THIRDPARTY_ENV_NAME)
        write_thirdparty_catalog(target_home)
    elif profile == "openai":
        write_openai_catalog(target_home)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
